# --- Tatum (chain reads) ---------------------------------------------
# Dashboard: https://dashboard.tatum.io  (Sui Mainnet gRPC gateway)
TATUM_API_KEY=
TATUM_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443
# native (HTTP/2 gRPC, default) or grpcweb
TATUM_GRPC_TRANSPORT=native
# Minimum spacing between Tatum calls in ms (free tier rate-limits bursts)
TATUM_MIN_INTERVAL_MS=350
# Archival fallback for transactions pruned from full nodes
SUI_ARCHIVAL_GRAPHQL=https://graphql.mainnet.sui.io/graphql

# --- Walrus Memory (what WatchSeal learned) --------------------------
# Account ID + delegate private key from https://memory.walrus.xyz/dashboard
# If both are empty, WatchSeal falls back to ~/.memwal/credentials.json
# (written by the Walrus Memory Claude Code plugin login), then to an offline mock.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=watchseal
MEMWAL_MAX_DISTANCE=0.8
# Set to 1 to force the offline MemWalMock
MEMWAL_MOCK=

# --- Claude (risk agent) ---------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---------------------------------------------------------------
# 1 = replay recorded Mainnet history from fixtures/ (no network needed)
WATCHSEAL_OFFLINE=
WATCHSEAL_STATE_FILE=data/state.json
